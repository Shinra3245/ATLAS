# Clave de Claude. Copiar este archivo a backend/.env y pegarla aquí.
# backend/.env no se versiona.
ANTHROPIC_API_KEY=
# Modelo del chat. Haiku responde rápido; claude-sonnet-5 es la alternativa.
ANTHROPIC_MODEL=claude-haiku-4-5

# Render los configura sin copiar backend/.env dentro de la imagen.
ATLAS_ENV=development
ATLAS_FIREBASE_PROJECT_ID=
# Límite técnico del asistente para el despliegue de una instancia/worker.
ATLAS_ASSISTANT_HOURLY_LIMIT=200
