# Solo desarrollo local; npm start utiliza el proxy del servidor de visualización.
ATLAS_API_TARGET=http://127.0.0.1:8000
ATLAS_PREVIEW_PORT=5173
# npm start, por defecto, escucha únicamente en localhost.
# Para compartir, indicar las IP privadas del nodo de forma explícita:
# ATLAS_PREVIEW_HOSTS=127.0.0.1,192.168.10.10,100.121.183.26
